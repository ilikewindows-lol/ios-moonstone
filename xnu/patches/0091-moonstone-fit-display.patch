+/*
+ * Copy one layer rectangle (logical canvas coordinates, w x h at dx,dy, from
+ * the source at sx,sy) into the panel, scaled by fFitNum/fFitDen with nearest
+ * neighbour sampling. fXMap/fYMap give every panel column/row its logical
+ * coordinate, so the loops only touch panel pixels inside the rectangle.
+ */
+void
+AppleCLCD::blitScaled(uintptr_t srcBase, uint32_t srcPitch, int32_t sx, int32_t sy,
+    int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	int32_t px0 = -1, px1 = -1, py0 = -1, py1 = -1;
+	for (uint32_t px = 0; px < fWidth; px++) {
+		int32_t lx = fXMap[px];
+		if (lx >= dx && lx < dx + w) {
+			if (px0 < 0) {
+				px0 = (int32_t)px;
+			}
+			px1 = (int32_t)px + 1;
+		}
+	}
+	for (uint32_t py = 0; py < fHeight; py++) {
+		int32_t ly = fYMap[py];
+		if (ly >= dy && ly < dy + h) {
+			if (py0 < 0) {
+				py0 = (int32_t)py;
+			}
+			py1 = (int32_t)py + 1;
+		}
+	}
+	if (px0 < 0 || py0 < 0) {
+		return;
+	}
+	for (int32_t py = py0; py < py1; py++) {
+		int32_t ly = fYMap[py];
+		if (ly < dy || ly >= dy + h) {
+			continue;
+		}
+		const uint32_t *srow = (const uint32_t *)(srcBase + (uint64_t)(sy + (ly - dy)) * srcPitch +
+		    (uint64_t)sx * 4);
+		uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes);
+		for (int32_t px = px0; px < px1; px++) {
+			int32_t lx = fXMap[px] - dx;
+			if (lx >= 0 && lx < w) {
+				drow[px] = srow[lx];
+			}
+		}
+	}
+}
